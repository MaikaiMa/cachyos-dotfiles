:root {
  --dms-dark: <* if {{ is_dark_mode }} *>1<* else *>0<* endif *>;
  --dms-primary: {{colors.primary.default.hex}};
  --dms-on-primary: {{colors.on_primary.default.hex}};
  --dms-secondary-container: {{colors.secondary_container.default.hex}};
  --dms-on-secondary-container: {{colors.on_secondary_container.default.hex}};
  --dms-surface-container: {{colors.surface_container.default.hex}};
  --dms-surface-container-high: {{colors.surface_container_high.default.hex}};
  --dms-on-surface: {{colors.on_surface.default.hex}};
  --dms-outline-variant: {{colors.outline_variant.default.hex}};
}
