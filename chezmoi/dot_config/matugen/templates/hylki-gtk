/* Rendered by matugen from ~/.config/matugen/templates/hylki-gtk on every
   theme or wallpaper change; do not edit. The libadwaita named colours on
   the DMS palette, in the mode that was active at the render: GTK 4 reads
   this file once at start-up, so Hylki shows a new palette after a restart.
   Surfaces follow Ghostty, Vicinae and Zen: surface_container, not the
   near-black surface. The view (message list and reading pane) is a step
   below it in both modes, the way Adwaita sets its view apart. */

@define-color accent_bg_color {{colors.primary.default.hex}};
@define-color accent_fg_color {{colors.on_primary.default.hex}};
@define-color accent_color {{colors.primary.default.hex}};

