// Input Configuration:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            layout "us"
            // Caps is a momentary app-layer modifier. Both Shift keys enable
            // Caps Lock deliberately; either Shift key cancels it again.
            options "lv5:caps_switch,shift:both_capslock_cancel"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // Clickfinger: a two-finger click is a right click and the bottom 10 mm
        // stops being libinput's software-button strip, which ignored resting
        // fingers during scrolls. Corner clicks become plain left clicks.
        click-method "clickfinger"
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    workspace-auto-back-and-forth

    // niri-wm/niri#2233: niri receives the power-key press that woke the system
    // and suspends again. logind suspends instead and ignores the wake press;
    // see system/logind.conf.d/50-power-key.conf. Drop both once #2233 is fixed.
    disable-power-key-handling
}

gestures {
    hot-corners {
        off
    }
}
