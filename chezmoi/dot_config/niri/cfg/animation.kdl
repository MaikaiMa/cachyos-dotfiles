animations {
    workspace-switch {
        spring damping-ratio=0.92 stiffness=1100 epsilon=0.0001
    }

    window-open {
        duration-ms 160
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    window-close {
        duration-ms 140
        curve "cubic-bezier" 0.4 0.0 0.2 1.0
    }

    horizontal-view-movement {
        spring damping-ratio=0.96 stiffness=1000 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.96 stiffness=1000 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.96 stiffness=1000 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=1200 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 160
        curve "ease-out-expo"
    }

    overview-open-close {
        spring damping-ratio=0.92 stiffness=1000 epsilon=0.0001
    }
}
