workspace "inbox"
workspace "browse"
workspace "code"
workspace "game"

window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Browsers: Zen, with Firefox kept as the backup.
window-rule {
    match app-id=r#"^(zen|firefox)$"#
    open-on-workspace "browse"
}

// Editor, terminals, Meld and Claude (coding partner) share the code workspace.
window-rule {
    match app-id=r#"^(Alacritty|com\.mitchellh\.ghostty|dev\.zed\.Zed|org\.gnome\.Meld|com\.anthropic\.Claude)$"#
    open-on-workspace "code"
}

// Mail, the general-purpose assistant and Blip (file transfer; its X11 class is
// MainKt): things that arrive and want an answer.
window-rule {
    match app-id=r#"^(co\.hyprlab\.Hylki|Chatgpt|MainKt)$"#
    open-on-workspace "inbox"
}

// X11 windows cannot use the activation token that Spotlight hands out, so
// niri would leave Blip unfocused on its workspace; force the focus.
window-rule {
    match app-id=r#"^MainKt$"#
    open-focused true
}

// Steam, Heroic, Lutris, Goverlay and the games they launch stay out of the
// way. Wine reports the executable name as the window class, so ".exe" and
// gamescope catch games started through Heroic or Lutris.
window-rule {
    match app-id=r#"^(steam|heroic|net\.lutris\.Lutris|goverlay|gamescope)$"#
    match app-id=r#"^steam_app_\d+$"#
    match app-id=r#"\.exe$"#
    open-on-workspace "game"
}

// Browsers, the editor, mail and the Steam main window keep the full width;
// everything else, including terminals and the AI assistants, opens at 50%.
window-rule {
    match app-id=r#"^(zen|firefox|dev\.zed\.Zed|co\.hyprlab\.Hylki)$"#
    match app-id="steam" title=r#"^[Ss]team$"#
    default-column-width { proportion 1.0; }
}

// Sushi (Files quick preview on space) is a transient overlay, not a column.
window-rule {
    match app-id=r#"^org\.gnome\.NautilusPreviewer$"#
    open-floating true
}

window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

layer-rule {
    match namespace="^dms:"
    background-effect {
        xray false
    }
}
