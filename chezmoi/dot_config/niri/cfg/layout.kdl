layout {
    // 6 px gutters; the struts put window edges on the bar's 8 px rhythm
    // (islands sit 8 px from the screen edge) and 6 px under the islands.
    gaps 6
    center-focused-column "never"

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        on
        width 1
    }

    border {
        off
    }

    struts {
        left 2
        right 2
        top -1
        bottom 2
    }
}
