#!/bin/sh
# Place Noctalia's native audio spectrum behind the active dotfiles bar.
set -eu

noctalia_command=${NOCTALIA_COMMAND:-noctalia}
niri_command=${NIRI_COMMAND:-niri}
config_home=${NOCTALIA_CONFIG_HOME:-${XDG_CONFIG_HOME:-"$HOME/.config"}}
config_dir=$config_home/noctalia
target=$config_dir/desktop-audio-glow.generated.toml
temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/noctalia-audio-glow.XXXXXX")
trap 'rm -rf "$temporary_dir"' EXIT HUP INT TERM

for command in awk jq "$noctalia_command" "$niri_command"; do
	if ! command -v "$command" >/dev/null 2>&1; then
		printf 'Required audio-glow command is missing: %s\n' "$command" >&2
		exit 1
	fi
done

merged_config=$temporary_dir/merged.toml
bar_values=$temporary_dir/bar-values
outputs=$temporary_dir/outputs.json
candidate=$temporary_dir/desktop-audio-glow.generated.toml
validation_dir=$temporary_dir/config

if ! "$noctalia_command" config export merged >"$merged_config"; then
	printf '%s\n' 'Could not export the effective Noctalia configuration.' >&2
	exit 1
fi

awk '
	BEGIN {
		in_bar = 0
		found = 0
		enabled = "false"
		position = "top"
		thickness = "34"
		padding = "0"
		margin_ends = "0"
		margin_edge = "0"
		radius = "0"
	}
	/^[[:space:]]*\[bar\.dotfiles\][[:space:]]*$/ {
		in_bar = 1
		found = 1
		next
	}
	in_bar && /^[[:space:]]*\[/ { exit }
	in_bar && /^[[:space:]]*[a-z_]+[[:space:]]*=/ {
		line = $0
		key = line
		sub(/[[:space:]]*=.*/, "", key)
		gsub(/^[[:space:]]+/, "", key)
		value = line
		sub(/^[^=]*=[[:space:]]*/, "", value)
		sub(/[[:space:]]*#.*/, "", value)
		gsub(/^[[:space:]"]+/, "", value)
		gsub(/[[:space:]"]+$/, "", value)
		if (key == "enabled") enabled = value
		if (key == "position") position = value
		if (key == "thickness") thickness = value
		if (key == "padding") padding = value
		if (key == "margin_ends") margin_ends = value
		if (key == "margin_edge") margin_edge = value
		if (key == "radius") radius = value
	}
	END {
		printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", found, enabled, position, thickness, padding, margin_ends, margin_edge, radius
	}
' "$merged_config" >"$bar_values"

IFS='	' read -r bar_found bar_enabled bar_position bar_thickness bar_padding bar_margin_ends bar_margin_edge bar_radius <"$bar_values"

{
	printf '%s\n' '# Generated by sync-noctalia-audio-glow; do not edit.'
	if [ "$bar_found" = 1 ] && [ "$bar_enabled" = true ]; then
		case $bar_position in
		top | bottom)
			if ! "$niri_command" msg -j outputs >"$outputs"; then
				printf '%s\n' 'Could not read the active Niri outputs.' >&2
				exit 1
			fi

			jq -r \
				--arg position "$bar_position" \
				--arg thickness "$bar_thickness" \
				--arg padding "$bar_padding" \
				--arg margin_ends "$bar_margin_ends" \
				--arg margin_edge "$bar_margin_edge" \
				--arg radius "$bar_radius" '
				def number($value; $name):
					try ($value | tonumber) catch error("invalid bar " + $name);
				(number($thickness; "thickness")) as $thickness_n |
				(number($padding; "padding")) as $padding_n |
				(number($margin_ends; "margin_ends")) as $margin_ends_n |
				(number($margin_edge; "margin_edge")) as $margin_edge_n |
				(number($radius; "radius")) as $radius_n |
				to_entries[] |
				select(.value.logical != null) |
				.value.logical as $logical |
				($thickness_n - (2 * $padding_n)) as $height |
				([$radius_n, $thickness_n / 2] | min) as $effective_radius |
				(if $padding_n >= $effective_radius
				 then 0
				 else
					($effective_radius - $padding_n) as $corner_distance |
					($effective_radius -
					 (($effective_radius * $effective_radius - $corner_distance * $corner_distance) | sqrt) |
					 ceil)
				 end) as $end_inset |
				($logical.width - (2 * ($margin_ends_n + $end_inset))) as $width |
				(if $position == "top"
				 then $margin_edge_n + ($thickness_n / 2)
				 else $logical.height - $margin_edge_n - ($thickness_n / 2)
				 end) as $cy |
				if $width <= 0 or $height <= 0 then
					error("bar geometry leaves no room for the audio glow")
				else
					"\n[desktop_widgets]\nenabled = true\n" +
					"\n[desktop_widgets.widget." + (("audio-glow@" + .key) | @json) + "]\n" +
					"type = \"audio_visualizer\"\n" +
					"output = " + (.key | @json) + "\n" +
					"cx = " + (($logical.width / 2) | tostring) + "\n" +
					"cy = " + ($cy | tostring) + "\n" +
					"box_width = " + ($width | tostring) + "\n" +
					"box_height = " + ($height | tostring) + "\n" +
					"rotation = 0.0\n" +
					"flip_x = false\n" +
					"flip_y = false\n" +
					"\n[desktop_widgets.widget." + (("audio-glow@" + .key) | @json) + ".settings]\n" +
					"bands = 48\n" +
					"mirrored = true\n" +
					"centered = true\n" +
					"show_when_idle = false\n" +
					"color_1 = \"primary\"\n" +
					"color_2 = \"secondary\"\n" +
					"background = false\n" +
					"background_padding = 0.0\n"
				end
			' "$outputs"
			;;
		esac
	fi
} >"$candidate"

if [ -f "$target" ] && cmp -s "$candidate" "$target"; then
	exit 0
fi

mkdir -p "$config_dir" "$validation_dir"
for config in "$config_dir"/*.toml; do
	[ -f "$config" ] || continue
	if [ "$config" != "$target" ]; then
		cp "$config" "$validation_dir/"
	fi
done
cp "$candidate" "$validation_dir/${target##*/}"

if ! "$noctalia_command" config validate "$validation_dir" >/dev/null; then
	printf '%s\n' 'Generated audio-glow configuration is invalid; the live file was not changed.' >&2
	exit 1
fi

mv "$candidate" "$target"
if ! "$noctalia_command" msg config-reload >/dev/null 2>&1; then
	printf '%s\n' 'Noctalia is not running; the audio glow will load on its next start.' >&2
fi
