#!/bin/sh
set -eu

# Blip is a Java 25 Compose app running through XWayland. xwayland-satellite
# maps X11 pixels 1:1 onto physical pixels, so the app must scale itself.
# Java 2D reads scale from sun.java2d.uiScale, and the native launcher in
# /opt/blip/bin has no options file, but the JVM honours JAVA_TOOL_OPTIONS.
# OpenJDK's X11 toolkit only supports integer scale factors, so the fractional
# output scale is rounded; on a 1.75 display Blip renders at 2x, slightly
# larger than native apps.

if [ "$#" -lt 1 ]; then
	printf 'Usage: %s COMMAND [ARG ...]\n' "${0##*/}" >&2
	exit 2
fi

for tool in niri jq; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'Missing required command: %s\n' "$tool" >&2
		exit 127
	fi
done

scale=$(niri msg --json focused-output 2>/dev/null | jq -r '(.logical.scale // empty) | [round, 1] | max') || scale=""

if [ -z "$scale" ]; then
	printf '%s\n' 'Could not determine the focused output scale from niri; launching unscaled.' >&2
	exec "$@"
fi

JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:-} -Dsun.java2d.uiScale=$scale"
JAVA_TOOL_OPTIONS=${JAVA_TOOL_OPTIONS# }
export JAVA_TOOL_OPTIONS

exec "$@"
