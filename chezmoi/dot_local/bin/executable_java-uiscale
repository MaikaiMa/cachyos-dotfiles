#!/bin/sh
set -eu

# Blip is a Java 25 Compose app running through XWayland; xwayland-satellite
# maps X11 pixels 1:1 onto physical pixels, so the app must scale itself. Its
# Conveyor launcher strips JAVA_TOOL_OPTIONS and only allows memory flags in
# CONVEYOR_JVM_OPTIONS, but the JDK's X11 toolkit reads J2D_UISCALE from the
# environment. That toolkit supports integer factors only, so the output
# scale is rounded; on a 1.75 display Blip renders at 2x.

if [ "$#" -lt 1 ]; then
	printf 'Usage: %s COMMAND [ARG ...]\n' "${0##*/}" >&2
	exit 2
fi

for tool in niri jq; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'Missing required command: %s\n' "$tool" >&2
		exit 127
	fi
done

scale=$(niri msg --json focused-output 2>/dev/null | jq -r '(.logical.scale // empty) | [round, 1] | max') || scale=""

if [ -z "$scale" ]; then
	printf '%s\n' 'Could not determine the focused output scale from niri; launching unscaled.' >&2
	exec "$@"
fi

J2D_UISCALE=$scale
export J2D_UISCALE

exec "$@"
