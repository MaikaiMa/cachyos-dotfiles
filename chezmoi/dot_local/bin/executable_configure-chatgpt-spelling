#!/bin/sh
# Enable British English and Dutch spelling in the ChatGPT desktop app.
set -eu

config_root=${XDG_CONFIG_HOME:-"$HOME/.config"}
profile_dir=$config_root/Codex
preferences=$profile_dir/Default/Preferences
dictionaries_dir=$profile_dir/Dictionaries
dutch_dictionary=$dictionaries_dir/nl-NL-3-0.bdic
dutch_dictionary_url=https://redirector.gvt1.com/edgedl/chrome/dict/nl-NL-3-0.bdic

for tool in curl jq mktemp pgrep; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'Required command not found: %s\n' "$tool" >&2
		exit 1
	fi
done

if pgrep -x ChatGPT >/dev/null 2>&1; then
	printf '%s\n' 'Close ChatGPT completely before configuring its spelling languages.' >&2
	exit 1
fi

if [ ! -f "$preferences" ]; then
	printf 'ChatGPT preferences not found: %s\n' "$preferences" >&2
	printf '%s\n' 'Start ChatGPT once, close it completely, and run this command again.' >&2
	exit 1
fi

mkdir -p "$dictionaries_dir"
dictionary_tmp=$(mktemp "$dictionaries_dir/.nl-NL-3-0.bdic.XXXXXX")
preferences_tmp=$(mktemp "$profile_dir/Default/.Preferences.XXXXXX")

cleanup() {
	rm -f -- "$dictionary_tmp" "$preferences_tmp"
}
trap cleanup EXIT HUP INT TERM

curl --proto '=https' --tlsv1.2 -fL \
	-o "$dictionary_tmp" "$dutch_dictionary_url"

magic=$(dd if="$dictionary_tmp" bs=4 count=1 2>/dev/null)
if [ "$magic" != BDic ]; then
	printf '%s\n' 'Downloaded Dutch dictionary has an invalid Chromium BDic header.' >&2
	exit 1
fi

chmod 0644 "$dictionary_tmp"
mv -f -- "$dictionary_tmp" "$dutch_dictionary"

jq \
	'.spellcheck.dictionaries = ["en-GB", "nl-NL"]
	 | .intl.selected_languages = "en-GB,en-US,en,nl-NL,nl"' \
	"$preferences" >"$preferences_tmp"
chmod --reference="$preferences" "$preferences_tmp"
mv -f -- "$preferences_tmp" "$preferences"

trap - EXIT HUP INT TERM
printf '%s\n' 'ChatGPT spelling configured for British English and Dutch.'
