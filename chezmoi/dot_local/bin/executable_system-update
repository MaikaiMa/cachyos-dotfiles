#!/bin/sh
# Update pacman, AUR, and Flatpak with the checks a plain `paru -Syu` skips:
# Arch news before (through paru), .pacnew files and reboot-worthy packages after.
set -eu

paru_command=${PARU_COMMAND:-paru}
checkupdates_command=${CHECKUPDATES_COMMAND:-checkupdates}
flatpak_command=${FLATPAK_COMMAND:-flatpak}
pacdiff_command=${PACDIFF_COMMAND:-pacdiff}
# These keep running the old code until the kernel or the session restarts.
reboot_pattern='^(linux-|mesa$|niri$|quickshell$|dms-shell|systemd$|greetd)'
greeter_package=greetd-dms-greeter-bin

usage() {
	printf 'Usage: %s [--yes | --pending]\n' "${0##*/}"
	printf '%s\n' 'Run paru -Syu (with unread Arch news) and flatpak update, then list .pacnew files and packages that need a reboot.'
	printf '%s\n' 'Asks before upgrading fragile packages when run in a terminal; --yes skips that question.'
	printf '%s\n' 'Writes last-report.md to SYSTEM_UPDATE_STATE_DIR (default: the system-update directory under XDG_STATE_HOME).'
	printf '%s\n' '--pending only lists pending updates, one tab-separated line each: source, name, old, new, fragile (0 or 1), reason (- unless fragile).'
}

assume_yes=false
pending_only=false
for argument in "$@"; do
	case $argument in
	--yes) assume_yes=true ;;
	--pending) pending_only=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
done

state_dir=${SYSTEM_UPDATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/system-update}
report_file=$state_dir/last-report.md

for tool in "$paru_command" "$checkupdates_command" "$pacdiff_command"; do
	if [ "$pending_only" = true ] && [ "$tool" = "$pacdiff_command" ]; then
		continue
	fi
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'Required command is missing: %s (pacman-contrib provides checkupdates and pacdiff)\n' "$tool" >&2
		exit 1
	fi
done

# Read-only: for the bar. No news check, no question, no upgrade, no report.
# checkupdates and paru -Qua print "name old -> new" (paru may append
# "[ignored]"); flatpak remote-ls knows only the new version, so the old one
# comes from flatpak list. The reason is the bar's one-line text for a
# fragile package; keep it in step with reboot_pattern.
print_pending() {
	{
		"$checkupdates_command" | sed 's/^/repo /' || true
		"$paru_command" -Qua | sed 's/^/aur /' || true
	} | awk -v pattern="$reboot_pattern" -v greeter="$greeter_package" '
		function reason(name) {
			if (name ~ /^linux-/) return "kernel: reboot needed"
			if (name == "quickshell" || name ~ /^dms-shell/) return "shell: restarts the bar"
			if (name == greeter || name ~ /^greetd/) return "greeter: re-sync needed"
			return "needs a reboot"
		}
		$4 == "->" && NF >= 5 {
			fragile = ($2 ~ pattern || $2 == greeter)
			printf "%s\t%s\t%s\t%s\t%d\t%s\n", $1, $2, $3, $5, fragile ? 1 : 0, fragile ? reason($2) : "-"
		}'
	if command -v "$flatpak_command" >/dev/null 2>&1; then
		installed=$("$flatpak_command" list --columns=application,version || true)
		"$flatpak_command" remote-ls --updates --columns=application,version | FLATPAK_INSTALLED=$installed awk -F '\t' '
			BEGIN {
				count = split(ENVIRON["FLATPAK_INSTALLED"], rows, "\n")
				for (i = 1; i <= count; i++) {
					split(rows[i], columns, "\t")
					if (!(columns[1] in old)) old[columns[1]] = columns[2]
				}
			}
			$1 != "" {
				printf "flatpak\t%s\t%s\t%s\t0\t-\n", $1, (old[$1] == "" ? "-" : old[$1]), ($2 == "" ? "-" : $2)
			}' || true
	fi
}

if [ "$pending_only" = true ]; then
	print_pending
	exit 0
fi

heading() {
	printf '\n== %s ==\n' "$1"
}

heading 'Arch news'
# paru fetches the news once during -Syu when NewsOnUpgrade is set; fetching
# it here as well gets the feed rate-limited (429). paru reads only the first
# of these files.
paru_conf=''
for candidate in "${PARU_CONF:-}" "$HOME/.config/paru/paru.conf" /etc/paru.conf; do
	if [ -n "$candidate" ] && [ -f "$candidate" ]; then
		paru_conf=$candidate
		break
	fi
done
if [ -n "$paru_conf" ] && grep -Eq '^[[:space:]]*NewsOnUpgrade' "$paru_conf"; then
	printf '%s\n' "paru prints unread Arch news before the upgrade (NewsOnUpgrade in $paru_conf)."
else
	printf '%s\n' 'NewsOnUpgrade is off in the paru configuration; check https://archlinux.org/news/ yourself.' >&2
fi

heading 'Pending updates'
# checkupdates exits 2 and paru -Qua exits 1 when nothing is pending.
pending=$(
	{
		"$checkupdates_command" || true
		"$paru_command" -Qua || true
	} | awk 'NF'
)
pending_names=$(printf '%s\n' "$pending" | awk 'NF { print $1 }')
if [ -n "$pending" ]; then
	printf '%s\n' "$pending" | wc -l | sed 's/$/ package(s) from the repositories and the AUR./'
else
	printf '%s\n' 'Nothing pending from the repositories or the AUR.'
fi
reboot_candidates=$(printf '%s\n' "$pending_names" | grep -E "$reboot_pattern" || true)
fragile=$(printf '%s\n' "$pending" | awk -v pattern="$reboot_pattern" -v greeter="$greeter_package" 'NF && ($1 ~ pattern || $1 == greeter)')

# These keep running old code until a reboot or a greeter re-sync and are the
# ones that tend to break the desktop, so they deserve one look before the
# upgrade runs.
if [ -n "$fragile" ]; then
	heading 'Fragile packages'
	printf '%s\n' "$fragile" | sed 's/^/  /'
	if [ -t 0 ] && [ "$assume_yes" = false ]; then
		printf '%s' 'Continue with the upgrade? [Y/n] '
		if ! read -r answer; then
			answer=n
		fi
		case $answer in
		'' | y | Y) ;;
		*)
			printf '%s\n' 'Upgrade cancelled.'
			exit 0
			;;
		esac
	fi
fi

heading 'Repositories and AUR'
"$paru_command" -Syu

heading 'Flatpak'
if command -v "$flatpak_command" >/dev/null 2>&1; then
	"$flatpak_command" update
else
	printf '%s\n' 'flatpak is not installed; skipped.'
fi

heading 'After the update'
pacnews=$("$pacdiff_command" -o || true)
follow_up=false
follow_ups=''

add_follow_up() {
	follow_up=true
	follow_ups=$follow_ups$1'
'
}

if [ -n "$pacnews" ]; then
	printf '%s\n' 'Unmerged configuration files:'
	printf '%s\n' "$pacnews" | sed 's/^/  /'
	merge_message="Merge them with: sudo DIFFPROG='nvim -d' pacdiff"
	printf '%s\n' "$merge_message"
	add_follow_up "Unmerged .pacnew files. $merge_message"
	case $pacnews in
	*/etc/pacman.conf.pacnew*)
		sessions_message='After merging pacman.conf, re-run scripts/setup-sessions.sh so its NoExtract line survives (ADR-0023).'
		printf '%s\n' "$sessions_message"
		add_follow_up "$sessions_message"
		;;
	esac
fi

if printf '%s\n' "$pending_names" | grep -qx "$greeter_package"; then
	greeter_message='The greeter was updated; re-sync it with scripts/setup-greetd.sh.'
	printf '%s\n' "$greeter_message"
	add_follow_up "$greeter_message"
fi

if [ -n "$reboot_candidates" ]; then
	reboot_message='Reboot soon; these keep running the old code until then:'
	printf '%s\n' "$reboot_message"
	printf '%s\n' "$reboot_candidates" | sed 's/^/  /'
	add_follow_up "$reboot_message $(printf '%s\n' "$reboot_candidates" | paste -sd ' ' - | sed 's/ /, /g')."
fi

if [ "$follow_up" = false ]; then
	printf '%s\n' 'No .pacnew files and nothing that needs a reboot.'
fi

bullets() {
	printf '%s\n' "$1" | sed '/^$/d; s/^/- /'
}

write_pacnew_diffs() {
	printf '%s\n' "$pacnews" | while IFS= read -r pacnew; do
		[ -n "$pacnew" ] || continue
		printf '\n### %s\n\n' "$pacnew"
		diff_status=0
		diff_output=$(diff -u "${pacnew%.pacnew}" "$pacnew" 2>/dev/null) || diff_status=$?
		if [ "$diff_status" -gt 1 ]; then
			printf '%s\n' 'No diff: the live file is missing or not readable without sudo.'
		else
			printf '%s\n' '```diff' "$diff_output" '```'
		fi
	done
}

write_report() {
	printf '# System update %s\n' "$(date '+%Y-%m-%d %H:%M')"
	printf '\n## Arch news\n\n'
	printf '%s\n' 'paru printed the unread posts before the upgrade; they are not copied here because a second feed fetch gets rate-limited. Re-read them at https://archlinux.org/news/ if needed.'
	printf '\n## Fragile packages\n\n'
	if [ -n "$fragile" ]; then
		bullets "$fragile"
	else
		printf '%s\n' 'None.'
	fi
	printf '\n## Updated packages\n\n'
	if [ -n "$pending" ]; then
		printf '%s\n\n' 'These were pending before paru -Syu, which is what a normal run upgrades.'
		bullets "$pending"
	else
		printf '%s\n' 'None pending before the run.'
	fi
	printf '\n## Unmerged .pacnew files\n'
	if [ -n "$pacnews" ]; then
		write_pacnew_diffs
	else
		printf '\n%s\n' 'None.'
	fi
	printf '\n## Follow-ups\n\n'
	if [ -n "$follow_ups" ]; then
		bullets "$follow_ups"
	else
		printf '%s\n' 'None.'
	fi
	printf '\n## For an agent\n\n'
	printf '%s\n' 'Read this report. For every fragile package, find the upstream release notes for the version jump and tell me what changed that could affect a CachyOS machine running Niri, Quickshell, DankMaterialShell, greetd with dms-greeter, and Btrfs snapshots via snap-pac. For every .pacnew diff, tell me which hunks to merge and which to drop, and give me the pacdiff choice per file. End with a short checklist of what to verify after the reboot. Do not run anything; I will.'
}

mkdir -p "$state_dir"
write_report >"$report_file.tmp"
mv -f "$report_file.tmp" "$report_file"
report_path=$(
	CDPATH='' cd -- "$state_dir"
	pwd
)/last-report.md

printf '\n%s\n' "Report written to $report_path."
if [ "$follow_up" = true ] || [ -n "$fragile" ]; then
	printf '%s\n' 'Hand the report to an agent with:'
	printf '%s\n' "Read $report_path and follow its \"For an agent\" section."
fi
