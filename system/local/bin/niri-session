#!/bin/sh
# The session's stderr would otherwise land on the greetd VT. The absolute path
# below is what keeps this wrapper out of its own way: niri-session re-execs
# "$0" through the login shell, so a bare name would resolve back to here.
set -eu

mkdir -p "$HOME/.local/state"

exec /usr/bin/niri-session >"$HOME/.local/state/niri-session.log" 2>&1
