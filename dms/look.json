      ],
      "centerWidgets": [
        "weather",
        "clock",
        "battery"
      ],
      "rightWidgets": [
        {
          "id": "music",
          "mediaSize": 2
        },
        "systemTray",
        "dotfilesDashboard",
        {
          "id": "systemUpdate",
